{
  "name": "projected-typescript",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "projected": "node packages/cli/bin/projected.js",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm build && pnpm lint && pnpm test && pnpm -r --if-present run check",
    "test:integration": "PROJECTED_TEST_DATABASE_URL=postgres://projected:projected@localhost:55432/projected PROJECTED_TEST_KAFKA_BROKERS=localhost:9092 PROJECTED_TEST_NATS_URL=nats://localhost:4222 vitest run",
    "mutate": "pnpm -r --workspace-concurrency=1 --if-present run mutate"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
