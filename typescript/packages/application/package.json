{
  "name": "@projected/application",
  "version": "0.1.0",
  "description": "Application layer for projected: CQRS contracts, handlers, ports and the transport-neutral dispatcher. Zero I/O.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzokov/projected.git",
    "directory": "typescript/packages/application"
  },
  "homepage": "https://github.com/martinzokov/projected#readme",
  "bugs": "https://github.com/martinzokov/projected/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-sourced": {
      "types": "./dist/event-sourced/index.d.ts",
      "default": "./dist/event-sourced/index.js"
    },
    "./state-based": {
      "types": "./dist/state-based/index.d.ts",
      "default": "./dist/state-based/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@projected/domain": "workspace:*",
    "better-result": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@projected/store-memory": "workspace:*",
    "@projected/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
