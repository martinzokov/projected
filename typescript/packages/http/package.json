{
  "name": "@projected/http",
  "version": "0.1.1",
  "description": "HTTP adapters for projected: business-operation endpoints and OpenAPI derived from contracts, typed clients, and a Result-based HTTP client.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzokov/projected.git",
    "directory": "typescript/packages/http"
  },
  "homepage": "https://github.com/martinzokov/projected#readme",
  "bugs": "https://github.com/martinzokov/projected/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@projected/application": "workspace:*",
    "better-result": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@projected/store-memory": "workspace:*",
    "@projected/testing": "workspace:*",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
