{
  "name": "@projected/opentelemetry",
  "version": "0.1.1",
  "description": "OpenTelemetry implementation of projected's Telemetry port: spans for operations, aggregates, event handlers, HTTP and messaging, with W3C trace-context propagation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzokov/projected.git",
    "directory": "typescript/packages/opentelemetry"
  },
  "homepage": "https://github.com/martinzokov/projected#readme",
  "bugs": "https://github.com/martinzokov/projected/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@projected/application": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@projected/http": "workspace:*",
    "@projected/messaging": "workspace:*",
    "@projected/store-memory": "workspace:*",
    "@projected/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
