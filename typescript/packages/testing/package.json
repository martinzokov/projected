{
  "name": "@projected/testing",
  "version": "0.1.1",
  "description": "Test helpers for projected: given/when/then for decisions, deterministic clocks and ids, and conformance suites for every store and transport.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzokov/projected.git",
    "directory": "typescript/packages/testing"
  },
  "homepage": "https://github.com/martinzokov/projected#readme",
  "bugs": "https://github.com/martinzokov/projected/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-sourced": {
      "types": "./dist/event-sourced/index.d.ts",
      "default": "./dist/event-sourced/index.js"
    },
    "./state-based": {
      "types": "./dist/state-based/index.d.ts",
      "default": "./dist/state-based/index.js"
    },
    "./messaging": {
      "types": "./dist/messaging.d.ts",
      "default": "./dist/messaging.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@projected/application": "workspace:*",
    "fast-check": "4.10.2"
  },
  "peerDependencies": {
    "vitest": ">=3",
    "@projected/messaging": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@projected/messaging": {
      "optional": true
    }
  },
  "devDependencies": {
    "@projected/messaging": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
