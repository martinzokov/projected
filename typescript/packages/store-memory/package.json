{
  "name": "@projected/store-memory",
  "version": "0.1.0",
  "description": "In-memory adapters for every projected storage port: events, checkpoints, idempotency, documents. For tests, local development and demos.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-sourced": {
      "types": "./dist/event-sourced/index.d.ts",
      "default": "./dist/event-sourced/index.js"
    },
    "./state-based": {
      "types": "./dist/state-based/index.d.ts",
      "default": "./dist/state-based/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@projected/application": "workspace:*"
  },
  "devDependencies": {
    "@projected/testing": "workspace:*"
  }
}
