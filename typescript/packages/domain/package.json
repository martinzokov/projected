{
  "name": "@projected/domain",
  "version": "0.1.0",
  "description": "Pure domain kernel for projected: Result, schemas, events, aggregates and business errors. Zero I/O.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-sourced": {
      "types": "./dist/event-sourced/index.d.ts",
      "default": "./dist/event-sourced/index.js"
    },
    "./state-based": {
      "types": "./dist/state-based/index.d.ts",
      "default": "./dist/state-based/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "better-result": "^3.0.1",
    "zod": "^4.6.7"
  }
}
