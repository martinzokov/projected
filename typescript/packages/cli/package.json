{
  "name": "@projected/cli",
  "version": "0.1.1",
  "description": "The projected command line: architecture checks, OpenAPI generation and contract immutability locks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzokov/projected.git",
    "directory": "typescript/packages/cli"
  },
  "homepage": "https://github.com/martinzokov/projected#readme",
  "bugs": "https://github.com/martinzokov/projected/issues",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "projected": "./bin/projected.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "skills",
    "vendor",
    "spec"
  ],
  "dependencies": {
    "@projected/application": "workspace:*",
    "@projected/architecture": "workspace:*",
    "@projected/http": "workspace:*",
    "@projected/runtime": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node scripts/pack-assets.mjs copy",
    "postpack": "node scripts/pack-assets.mjs clean"
  }
}
