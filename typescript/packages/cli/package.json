{
  "name": "@projected/cli",
  "version": "0.1.0",
  "description": "The projected command line: architecture checks, OpenAPI generation and contract immutability locks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "projected": "./bin/projected.js"
