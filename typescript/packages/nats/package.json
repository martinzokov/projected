    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@projected/application": "workspace:*",
    "@projected/messaging": "workspace:*"
  },
  "devDependencies": {
    "@projected/testing": "workspace:*"
  }
}
